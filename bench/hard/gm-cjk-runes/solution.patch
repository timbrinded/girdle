+func lastRune(n ast.Node, source []byte) (rune, bool) {
+	for cur := n; cur != nil; cur = cur.PreviousSibling() {
+		inline, ok := cur.(ast.InlineNode)
+		if !ok {
+			break
+		}
+		r, ok := inline.LastRune(source)
+		if ok {
+			return r, true
+		}
+	}
+	return 0, false
