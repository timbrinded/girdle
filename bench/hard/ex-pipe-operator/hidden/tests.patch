+func TestParse_pipe_operator(t *testing.T) {
+	input := "arr | map(.foo) | len() | Foo()"
+	expect := &CallNode{
+		Callee: &IdentifierNode{Value: "Foo"},
+		Arguments: []Node{
+			&CallNode{
+				Callee: &IdentifierNode{Value: "len"},
+				Arguments: []Node{
+					&BuiltinNode{
+						Name: "map",
+						Arguments: []Node{
+							&IdentifierNode{Value: "arr"},
