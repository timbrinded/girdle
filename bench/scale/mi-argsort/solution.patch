+
+class ArgsortTests(TestCase):
+    def test_basic(self):
+        self.assertEqual(mi.argsort([30, 10, 20]), [1, 2, 0])
+        self.assertEqual(mi.argsort([]), [])
+
+    def test_stable(self):
+        self.assertEqual(mi.argsort([2, 1, 2, 1]), [1, 3, 0, 2])
+        self.assertEqual(mi.argsort([2, 1, 2, 1], reverse=True), [0, 2, 1, 3])
+
+    def test_key_and_iterator(self):
+        self.assertEqual(mi.argsort(iter('bAc'), key=str.lower), [1, 0, 2])
