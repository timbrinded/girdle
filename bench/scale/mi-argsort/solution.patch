+def argsort(iterable, *, key=None, reverse=False):
+    """Return the indices that would sort *iterable*.
+
+        >>> argsort([30, 10, 20])
+        [1, 2, 0]
+
+    Items that compare equal keep their original order, also when *reverse*
+    is true, just as with :func:`sorted`. *key* works as it does for
+    :func:`sorted`:
+
+        >>> argsort(['b', 'A', 'c'], key=str.lower)
+        [1, 0, 2]
+        >>> argsort([1, 3, 3, 2], reverse=True)
+        [1, 2, 3, 0]
+
+    """
+    values = list(iterable) if key is None else list(map(key, iterable))
+    return sorted(range(len(values)), key=values.__getitem__, reverse=reverse)
+
